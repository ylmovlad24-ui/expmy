{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "warn",
    "eqeqeq": "error",
    "curly": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  }
}
